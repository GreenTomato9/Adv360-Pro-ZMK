#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE      0
#define QWERTY    1
#define FN        2
#define MOD       3
#define MOUSE     4
#define NAV       5
#define SYMBOLS   6
#define STENO     7

/ {
    behaviors {
        #include "macros.dtsi"
#include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &none                                                                    &mo 3   &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp F     &kp P      &kp B   &tog 1                                                                   &tog 1  &kp J   &kp L   &kp U      &kp Y     &kp SEMI  &kp LBKT
&kp NUHS   &kp A      &kp R     &kp S     &kp T      &kp G   &to 4              &kp LCTRL  &kp LALT    &kp LGUI  &kp RCTRL            &tog 7  &kp M   &kp N   &kp E      &kp I     &kp O     &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp D      &kp V                                 &kp TAB     &kp ESC                                &kp K   &kp H   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT                  &kp SPACE  &kp ENTER  &mo 5       &mo 5     &mo 6      &kp BSPC                  &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        qwerty {
            display-name = "Qwerty";
            bindings = <
&none      &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &none                                                                    &mo 3      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &trans                                                                   &trans     &kp Y   &kp U   &kp I      &kp O     &kp P     &kp LBKT
&kp NUHS   &kp A      &kp S     &kp D     &kp F      &kp G   &tog 4             &kp LCTRL  &kp LALT    &kp LGUI  &kp RCTRL            &kp KP_N4  &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                                 &kp TAB     &kp ESC                                   &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT                  &kp SPACE  &kp ENTER  &mo 5       &mo 5     &mo 6      &kp BSPC                     &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3      &kp F4              &kp F5        &kp F6  &trans                                                    &mo 3  &kp F7  &kp F8            &kp F9              &kp F10       &kp F11  &kp F12
&trans  &trans  &trans      &trans              &trans        &trans  &none                                                     &none  &trans  &trans            &trans              &trans        &trans   &trans
&trans  &trans  &kp C_RW    &kp C_FAST_FORWARD  &kp C_PP      &trans  &none           &trans  &trans    &trans  &trans          &none  &trans  &kp C_PLAY_PAUSE  &kp C_FAST_FORWARD  &kp C_REWIND  &trans   &trans
&trans  &trans  &kp C_MUTE  &kp C_VOL_DN        &kp C_VOL_UP  &trans                          &trans    &trans                         &trans  &kp C_VOL_UP      &kp C_VOL_DN        &kp C_MUTE    &trans   &trans
&trans  &trans  &trans      &trans              &trans                        &trans  &trans  &trans    &trans  &trans  &trans                 &trans            &trans              &trans        &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                                        &trans        &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                                                  &bootloader   &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none               &none  &none    &bt BT_CLR  &none                        &stp STP_BAT  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                                    &none    &none                                                  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                                    &none  &none  &none    &none       &bl BL_TOG  &rgb_ug RGB_TOG                       &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        gaming {
            display-name = "Mouse";
            bindings = <
&none     &kp N1     &kp N2  &none  &kp N3  &kp N4  &to 0                                                        &none  &none     &none     &none     &none     &none     &none
&none     &kp ESC    &kp Q   &kp W  &kp E   &kp R   &kp T                                                        &none  &none     &none     &none     &none     &none     &none
&kp TAB   &kp LSHFT  &kp A   &kp S  &kp D   &kp F   &kp G             &kp N7  &kp N9    &none  &none             &none  &mkp MB3  &mkp MB1  &mkp MB2  &mkp MB4  &mkp MB5  &none
&kp NUBS  &kp LCTRL  &kp X   &none  &kp C   &kp V                             &kp N8    &none                           &none     &none     &none     &none     &none     &none
&none     &none      &kp Z   &none  &kp B                  &kp MINUS  &kp N5  &kp N6    &none  &none  &kp MINUS                   &none     &none     &none     &none     &none
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
&none      &none             &none             &none           &none              &none  &none                                                            &none  &none  &none           &none          &none          &none            &none
&none      &kp HOME          &kp PG_DN         &kp PG_UP       &kp END            &none  &none                                                            &none  &none  &kp LS(HOME)    &kp LS(PG_UP)  &kp LS(PG_DN)  &kp LS(END)      &none
&none      &kp LEFT          &kp DOWN          &kp UP          &kp RIGHT          &none  &none         &kp LCTRL  &kp LALT    &kp RALT  &kp RCTRL         &none  &none  &kp LEFT_ARROW  &kp UP_ARROW   &kp DOWN       &kp RIGHT_ARROW  &none
&kp LSHFT  &kp LC(LS(LEFT))  &kp LC(LS(DOWN))  &kp LC(LS(UP))  &kp LC(LS(RIGHT))  &none                           &none       &none                              &none  &kp LC(LEFT)    &kp LC(UP)     &kp LC(DOWN)   &kp LC(RIGHT)    &kp RSHFT
&none      &none             &none             &none           &none                            &none  &none      &trans      &trans    &none      &none                &none           &none          &none          &none            &none
            >;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
&none             &none             &none                 &none      &none         &none      &none                                                        &none   &none          &none           &none                 &none                &none           &none
&kp LC(LA(NUBS))  &kp N4            &kp N2                &kp N3     &kp N1        &kp N5     &none                                                        &trans  &kp N6         &kp N0          &kp N8                &kp N9               &kp N7          &kp CARET
&kp LC(LA(N4))    &kp LS(NUHS)      &kp AMPS              &kp AT     &kp RPAR      &kp EXCL   &none         &kp LCTRL  &kp LALT    &none  &none            &none   &kp LS(MINUS)  &kp STAR        &kp LEFT_PARENTHESIS  &kp LC(LA(N9))       &kp LC(LA(N8))  &kp RIGHT_BRACKET
&kp PLUS          &kp LC(LA(RBKT))  &kp LC(LA(NUMBER_2))  &kp MINUS  &kp NUHS      &kp PRCNT                           &none       &none                           &kp HASH       &kp LC(LA(N7))  &kp LC(LA(N0))        &kp LS(NON_US_BSLH)  &kp NUBS        &kp EQUAL
&none             &none             &none                 &none      &kp LS(RBKT)                    &none  &none      &none       &none  &none  &kp BSPC                         &none           &none                 &none                &none           &none
            >;
        };

        steno {
            display-name = "Steno";
            bindings = <
&none  &none   &none   &none   &none   &none   &none                                              &none   &none   &none   &none   &none   &none     &none
&none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &none                                              &none   &kp N6  &kp N7  &kp N8  &kp N9  &kp N0    &none
&none  &kp Q   &kp W   &kp E   &kp R   &kp T   &none         &none  &none    &none  &none         &trans  &kp Y   &kp U   &kp I   &kp O   &kp P     &kp LBKT
&none  &kp A   &kp S   &kp D   &kp F   &kp G                        &none    &none                        &kp H   &kp J   &kp K   &kp L   &kp SEMI  &kp APOS
&none  &none   &none   &none   &none                  &kp C  &kp V  &none    &none  &kp N  &kp M                  &none   &none   &none   &none     &none
            >;
        };
    };
};
